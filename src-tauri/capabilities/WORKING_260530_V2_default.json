{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app permissions",
  "windows": ["main"],
  "permissions": [
  "core:default",
  "dialog:allow-open",
  "dialog:allow-save",
  "fs:allow-read-file",
  "fs:allow-write-file",
  "fs:allow-create",
  "store:default",
  {
    "identifier": "fs:scope",
    "allow": [
      { "path": "$HOME/**" },
      { "path": "$DOCUMENT/**" },
      { "path": "$DESKTOP/**" },
      { "path": "$DOWNLOAD/**" }
    ]
  }
]
}